{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dark Triad",
  "identifier": "com.darktriad.ide",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/dark-triad/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Dark Triad",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRDE5RTM4QzIxMkJFRDIKUldUU3ZoTENPSjdSOHhsaXN2OWdaM3dMNDZBdGZDK1FMSkpyUHZkaklyNXp1ZVdsN1R1djRUcWYK",
      "endpoints": [
        "https://github.com/ryan-ggarcia/darcktriad/releases/latest/download/latest.json"
      ]
    }
  }
}
